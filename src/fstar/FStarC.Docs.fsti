(** Reading the [FStar.Attributes.doc] attribute off top-level
    declarations, and exporting it as a versioned JSON document.

    This is deliberately small: documentation is an *opaque list of
    strings*, one per line, written explicitly as an ordinary attribute.
    F* does not parse the lines, does not render them, does not join
    them, and does not know about comment syntax. Keeping the payload
    uninterpreted is what lets the surface format -- Markdown or
    otherwise -- be decided outside the compiler, and changed later
    without touching it. The two
    consumers are the interactive [lookup] request (see
    [FStarC.Interactive.QueryHelper.docs_of_lid]) and the
    [--export_docs] command, whose JSON is the only externally
    supported surface: checked files remain a private format. *)
module FStarC.Docs

open FStarC
open FStarC.Effect

module S = FStarC.Syntax.Syntax

(** What the [doc] attribute of a declaration says. *)
type doc_status =
  (** No [doc] attribute on this declaration. *)
  | Doc_absent
  (** A [doc] attribute whose payload is a literal list of string
      literals, given here one line per element. The list may be empty:
      that is documentation which says nothing, and is still distinct
      from [Doc_absent]. *)
  | Doc_text of list string
  (** A [doc] attribute whose payload is *not* a literal list of string
      literals, e.g. [doc [a ^ b]], [doc (l1 @ l2)] or
      [doc some_list_constant]. Such an attribute is well-typed, but
      attributes are recorded unnormalized in checked modules, so there
      is nothing literal to report. The payload carries a rendering of
      the offending term, for diagnostics only. *)
  | Doc_unsupported of string

(** Read the [doc] attribute out of an attribute list. If several are
    present the first one wins, matching [Syntax.Util.get_attribute].

    That tie-break is what makes an interface authoritative. When a
    module has one, the attributes of the interface's declaration and of
    the implementation's are concatenated, interface first, so a
    declaration documented in both reports the interface's text. *)
val doc_of_attrs (attrs : list S.attribute) : ML doc_status

(** Read the [doc] attribute of a top-level declaration.

    Data constructors and declarations generated by typed splices always
    answer [Doc_absent]: the typechecker copies the attributes of their
    source declaration onto generated sigelts. Discriminators, projectors,
    and name-only generated declarations likewise answer [Doc_absent].
    Documenting generated declarations is out of scope, and reporting
    inherited text as their own would be wrong. *)
val doc_of_sigelt (se : S.sigelt) : ML doc_status

(** Identifier of the JSON schema emitted by [json_of_modul]. *)
val docs_schema_name : string

(** Version of the JSON schema emitted by [json_of_modul]. Bump this on
    any incompatible change to the emitted shape. *)
val docs_schema_version : int

(** The versioned JSON documentation index of a checked module: one
    entry per documented, public, user-written top-level declaration.

    Declarations generated by the typechecker -- including discriminators,
    projectors, and typed-splice results -- are excluded because they can
    inherit documentation from their source declaration.

    Emits [Warning_UnrecognizedAttribute] for each declaration carrying
    an unusable [doc] payload, and skips it. *)
val json_of_modul (m : S.modul) : ML Json.json

(** Given the path of a checked file, emit the JSON documentation index
    of the module it holds on stdout.

    If [path] names the checked file of an implementation and the
    checked file of the corresponding interface sits next to it, the
    interface is used instead: an interface is the authoritative
    description of what a module exports. If the implementation records
    that it was checked against an interface but the interface's checked
    file is unavailable, invalid, or belongs to another module, export
    fails rather than guessing at the public surface. A stale sibling
    interface is ignored when the requested implementation records no
    interface. *)
val export_docs (path : string) : ML unit
