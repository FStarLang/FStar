; F* verification rules (generated in sibling multifile-gen/ dir)
(dynamic_include ../multifile-gen/deps.build.inc)

; Extraction: Custard compiles the whole program, starting from Main, into
; one OCaml file.
(rule
 (targets Main.ml)
 (deps A.fst A.fst.checked B.fst B.fst.checked Main.fst Main.fst.checked)
 (action (run %{env:FSTAR_EXE=fstar.exe} --include . --already_cached "*,"
   --codegen OCaml --custard_entry_module Main -o Main.ml Main.fst)))

; Build the Main executable from extracted OCaml
(executable
  (name Main)
  (libraries fstar.lib)
  (preprocess (pps ppx_deriving_yojson))
  (flags (:standard -w -8-9-11-26-27-32-33-39)))
