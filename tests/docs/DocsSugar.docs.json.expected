{"schema":"fstar-module-docs","version":3,"module":"DocsSugar","interface":false,"declarations":[{"name":"DocsSugar.double","kind":"let","parent":null,"signature":"x: Prims.int -> Prims.int","type":{"k":"arrow","bs":[{"x":"x","q":"explicit","t":{"k":"fv","n":"Prims.int"}}],"c":{"eff":"Prims.Tot","res":{"k":"fv","n":"Prims.int"},"args":[]}},"definition":"fun x -> x + x <: Prims.int","refs":["Prims.int","Prims.op_Addition"],"range":{"file":"DocsSugar.fst","start_line":19,"start_col":0,"end_line":19,"end_col":32},"source":"let double (x:int) : int = x + x","definition_source":"let double (x:int) : int = x + x","doc":["Doubles 'x'."]},{"name":"DocsSugar.triple","kind":"let","parent":null,"signature":"x: Prims.int -> Prims.int","type":{"k":"arrow","bs":[{"x":"x","q":"explicit","t":{"k":"fv","n":"Prims.int"}}],"c":{"eff":"Prims.Tot","res":{"k":"fv","n":"Prims.int"},"args":[]}},"definition":"fun x -> 3 * x <: Prims.int","refs":["Prims.int","Prims.op_Star"],"range":{"file":"DocsSugar.fst","start_line":30,"start_col":0,"end_line":30,"end_col":32},"source":"let triple (x:int) : int = 3 * x","definition_source":"let triple (x:int) : int = 3 * x","doc":["Triples 'x'.","","Continuation lines are dedented by their common indentation, so this","paragraph sits flush with the first line rather than keeping the","four spaces it is written with.","","A leading `*` would be part of the text rather than stripped: the","payload is opaque, and deciding what a `*` means would be","interpreting it."]},{"name":"DocsSugar.quadruple","kind":"let","parent":null,"signature":"x: Prims.int -> Prims.int","type":{"k":"arrow","bs":[{"x":"x","q":"explicit","t":{"k":"fv","n":"Prims.int"}}],"c":{"eff":"Prims.Tot","res":{"k":"fv","n":"Prims.int"},"args":[]}},"definition":"fun x -> 4 * x <: Prims.int","refs":["Prims.int","Prims.op_Star"],"range":{"file":"DocsSugar.fst","start_line":34,"start_col":0,"end_line":34,"end_col":35},"source":"let quadruple (x:int) : int = 4 * x","definition_source":"let quadruple (x:int) : int = 4 * x","doc":null},{"name":"DocsSugar.attributed","kind":"let","parent":null,"signature":"x: Prims.int -> Prims.int","type":{"k":"arrow","bs":[{"x":"x","q":"explicit","t":{"k":"fv","n":"Prims.int"}}],"c":{"eff":"Prims.Tot","res":{"k":"fv","n":"Prims.int"},"args":[]}},"definition":"fun x -> x <: Prims.int","refs":["Prims.int"],"range":{"file":"DocsSugar.fst","start_line":43,"start_col":0,"end_line":43,"end_col":32},"source":"let attributed (x:int) : int = x","definition_source":"let attributed (x:int) : int = x","doc":["Documented and attributed at once. The doc comment desugars to its","own attribute set, so before `add_decorations` learned to","concatenate them this was rejected as \"more than one attribute set\".","Around a hundred declarations in `ulib` are written this way."]},{"name":"DocsSugar.nested","kind":"let","parent":null,"signature":"x: Prims.int -> Prims.int","type":{"k":"arrow","bs":[{"x":"x","q":"explicit","t":{"k":"fv","n":"Prims.int"}}],"c":{"eff":"Prims.Tot","res":{"k":"fv","n":"Prims.int"},"args":[]}},"definition":"fun x -> x <: Prims.int","refs":["Prims.int"],"range":{"file":"DocsSugar.fst","start_line":47,"start_col":0,"end_line":47,"end_col":28},"source":"let nested (x:int) : int = x","definition_source":"let nested (x:int) : int = x","doc":["A nested (* comment *) is part of the documentation text, not the","end of it."]},{"name":"DocsSugar.empty_comment_still_works","kind":"let","parent":null,"signature":"x: Prims.int -> Prims.int","type":{"k":"arrow","bs":[{"x":"x","q":"explicit","t":{"k":"fv","n":"Prims.int"}}],"c":{"eff":"Prims.Tot","res":{"k":"fv","n":"Prims.int"},"args":[]}},"definition":"fun x -> x + 1 <: Prims.int","refs":["Prims.int","Prims.op_Addition"],"range":{"file":"DocsSugar.fst","start_line":51,"start_col":0,"end_line":52,"end_col":12},"source":"let empty_comment_still_works (x:int) : int =\n  (**) x + 1","definition_source":"let empty_comment_still_works (x:int) : int =\n  (**) x + 1","doc":["The empty-comment idiom still lexes as `(*` followed by `*)`, so it","is a comment in expression position and not a marker."]},{"name":"DocsSugar.says_nothing","kind":"let","parent":null,"signature":"x: Prims.int -> Prims.int","type":{"k":"arrow","bs":[{"x":"x","q":"explicit","t":{"k":"fv","n":"Prims.int"}}],"c":{"eff":"Prims.Tot","res":{"k":"fv","n":"Prims.int"},"args":[]}},"definition":"fun x -> x <: Prims.int","refs":["Prims.int"],"range":{"file":"DocsSugar.fst","start_line":59,"start_col":0,"end_line":59,"end_col":34},"source":"let says_nothing (x:int) : int = x","definition_source":"let says_nothing (x:int) : int = x","doc":null},{"name":"DocsSugar.says_nothing_at_length","kind":"let","parent":null,"signature":"x: Prims.int -> Prims.int","type":{"k":"arrow","bs":[{"x":"x","q":"explicit","t":{"k":"fv","n":"Prims.int"}}],"c":{"eff":"Prims.Tot","res":{"k":"fv","n":"Prims.int"},"args":[]}},"definition":"fun x -> x <: Prims.int","refs":["Prims.int"],"range":{"file":"DocsSugar.fst","start_line":64,"start_col":0,"end_line":64,"end_col":44},"source":"let says_nothing_at_length (x:int) : int = x","definition_source":"let says_nothing_at_length (x:int) : int = x","doc":null},{"name":"DocsSugar.flag","kind":"type","parent":null,"signature":"Type0","type":{"k":"type"},"definition":null,"refs":[],"range":{"file":"DocsSugar.fst","start_line":68,"start_col":5,"end_line":68,"end_col":9},"source":"flag","definition_source":null,"doc":["A tiny type. As for a hand-written attribute, this documents","`flag` and neither `On` nor `Off`."]},{"name":"DocsSugar.On","kind":"constructor","parent":"DocsSugar.flag","signature":"DocsSugar.flag","type":{"k":"fv","n":"DocsSugar.flag"},"definition":null,"refs":["DocsSugar.flag"],"range":{"file":"DocsSugar.fst","start_line":69,"start_col":4,"end_line":69,"end_col":6},"source":"On","definition_source":null,"doc":null},{"name":"DocsSugar.Off","kind":"constructor","parent":"DocsSugar.flag","signature":"DocsSugar.flag","type":{"k":"fv","n":"DocsSugar.flag"},"defi