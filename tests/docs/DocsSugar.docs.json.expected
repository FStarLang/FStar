{"schema":"fstar-module-docs","version":4,"module":"DocsSugar","interface":false,"declarations":[{"name":"DocsSugar.double","kind":"let","parent":null,"signature":"x: Prims.int -> Prims.int","type":{"k":"arrow","bs":[{"x":"x","q":"explicit","t":{"k":"fv","n":"Prims.int"}}],"c":{"eff":"Prims.Tot","res":{"k":"fv","n":"Prims.int"},"pre":null,"post":null}},"definition":"fun x -> x + x <: Prims.int","refs":["Prims.int","Prims.op_Plus"],"range":{"file":"DocsSugar.fst","start_line":19,"start_col":0,"end_line":19,"end_col":32},"source":"let double (x:int) : int = x + x","definition_source":"let double (x:int) : int = x + x","doc":["Doubles 'x'."]},{"name":"DocsSugar.triple","kind":"let","parent":null,"signature":"x: Prims.int -> Prims.int","type":{"k":"arrow","bs":[{"x":"x","q":"explicit","t":{"k":"fv","n":"Prims.int"}}],"c":{"eff":"Prims.Tot","res":{"k":"fv","n":"Prims.int"},"pre":null,"post":null}},"definition":"fun x -> 3 * x <: Prims.int","refs":["Prims.int","Prims.op_Star"],"range":{"file":"DocsSugar.fst","start_line":30,"start_col":0,"end_line":30,"end_col":32},"source":"let triple (x:int) : int = 3 * x","definition_source":"let triple (x:int) : int = 3 * x","doc":["Triples 'x'.","","Continuation lines are dedented by their common indentation, so this","paragraph sits flush with the first line rather than keeping the","four spaces it is written with.","","A leading `*` would be part of the text rather than stripped: the","payload is opaque, and deciding what a `*` means would be","interpreting it."]},{"name":"DocsSugar.quadruple","kind":"let","parent":null,"signature":"x: Prims.int -> Prims.int","type":{"k":"arrow","bs":[{"x":"x","q":"explicit","t":{"k":"fv","n":"Prims.int"}}],"c":{"eff":"Prims.Tot","res":{"k":"fv","n":"Prims.int"},"pre":null,"post":null}},"definition":"fun x -> 4 * x <: Prims.int","refs":["Prims.int","Prims.op_Star"],"range":{"file":"DocsSugar.fst","start_line":34,"start_col":0,"end_line":34,"end_col":35},"source":"let quadruple (x:int) : int = 4 * x","definition_source":"let quadruple (x:int) : int = 4 * x","doc":null},{"name":"DocsSugar.attributed","kind":"let","parent":null,"signature":"x: Prims.int -> Prims.int","type":{"k":"arrow","bs":[{"x":"x","q":"explicit","t":{"k":"fv","n":"Prims.int"}}],"c":{"eff":"Prims.Tot","res":{"k":"fv","n":"Prims.int"},"pre":null,"post":null}},"definition":"fun x -> x <: Prims.int","refs":["Prims.int"],"range":{"file":"DocsSugar.fst","start_line":42,"start_col":0,"end_line":42,"end_col":32},"source":"let attributed (x:int) : int = x","definition_source":"let attributed (x:int) : int = x","doc":["Documented and attributed at once. The parser keeps this distinct","from the hand-written attribute set until it has enforced the rule","that a declaration has at most one such set."]},{"name":"DocsSugar.attributed_first","kind":"let","parent":null,"signature":"x: Prims.int -> Prims.int","type":{"k":"arrow","bs":[{"x":"x","q":"explicit","t":{"k":"fv","n":"Prims.int"}}],"c":{"eff":"Prims.Tot","res":{"k":"fv","n":"Prims.int"},"pre":null,"post":null}},"definition":"fun x -> x <: Prims.int","refs":["Prims.int"],"range":{"file":"DocsSugar.fst","start_line":46,"start_col":0,"end_line":46,"end_col":38},"source":"let attributed_first (x:int) : int = x","definition_source":"let attributed_first (x:int) : int = x","doc":["The attribute set may also precede the documentation comment."]},{"name":"DocsSugar.nested","kind":"let","parent":null,"signature":"x: Prims.int -> Prims.int","type":{"k":"arrow","bs":[{"x":"x","q":"explicit","t":{"k":"fv","n":"Prims.int"}}],"c":{"eff":"Prims.Tot","res":{"k":"fv","n":"Prims.int"},"pre":null,"post":null}},"definition":"fun x -> x <: Prims.int","refs":["Prims.int"],"range":{"file":"DocsSugar.fst","start_line":50,"start_col":0,"end_line":50,"end_col":28},"source":"let nested (x:int) : int = x","definition_source":"let nested (x:int) : int = x","doc":["A nested (* comment *) is part of the documentation text, not the","end of it."]},{"name":"DocsSugar.empty_comment_