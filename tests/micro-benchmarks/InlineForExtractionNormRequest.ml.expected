open Prims
let test (x : Prims.int) : Prims.int= Prims.int_one
let f2 (b : Prims.bool) : Prims.bool= Prims.not b
let f3 (b : Prims.bool) : Prims.bool= Prims.not b
let f4 (b : Prims.bool) : Prims.bool=
  Prims.not ((Prims.not b) || (Prims.not (Prims.not b)))
let f5 (b : Prims.bool) : Prims.bool=
  Prims.not ((Prims.not b) || (Prims.not (Prims.not b)))
