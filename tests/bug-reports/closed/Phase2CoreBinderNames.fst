module Phase2CoreBinderNames

(* Core names the binders it opens deterministically, above the largest index
   in its context. With --ext phase2_core, Core checks each argument of a
   constructor in a context holding the arguments before it, the last of which
   ([bind]) was the last name generated by GenSym: Core's names for the
   binders of the next argument were then those GenSym generated next, when
   Core opened the type of [bind]. Here, [c] was taken for the binder of
   [fun y -> ...] (Error 19, "Expected type m y got type m c"). From
   examples/typeclasses/Monad.fst. *)
assume val m : Type0 -> Type0

noeq type r =
  | Mk : (bind : (#a:Type0 -> #b:Type0 -> m a -> (a -> m b) -> m b)) ->
         (#a:Type0 -> #b:Type0 -> #c:Type0 -> x:m a -> f:(a -> m b) -> g:(b -> m c) ->
           Lemma (bind x (fun y -> bind (f y) g) == bind x (fun y -> bind (f y) g))) -> r
