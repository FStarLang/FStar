module ArrowUnfoldLimit
open FStar.All

(* Section 135.1.  An arrow behind more abbreviations than Custard unfolds is
   an error, not a call site that silently disagrees with its definition.  The
   aliases are generated: t0 is the arrow, and each t(i+1) is unit -> t(i). *)
